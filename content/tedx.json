  "about_tedx": {
    "heading": "What is TEDx?",
    "paragraphs": [
      "TEDx is a program of local, self-organized events that bring people together to share a TED-like experience. At a TEDx event, TED Talks video and live speakers combine to spark deep discussion and connection in a small group.",
      "These self-organized events are branded TEDx, where x = independently organized TED event. The TED Conference provides general guidance for the TEDx program, but individual TEDx events are self-organized (subject to certain rules and regulations)."
    ],
    "image": "../Assets/tedX/logo-black.png",
    "alt": "TEDx Event"
  },
